bazel_dep(name = "eigen", version = "5.0.1.bcr.1")
bazel_dep(name = "ffmpeg", version = "7.1.1.bcr.beta.13")
single_version_override(
    module_name = "ffmpeg",
    patch_strip = 1,
    patches = ["//patches:ffmpeg/sysctl.patch"],
    version = "7.1.1.bcr.beta.13",
)

bazel_dep(name = "opengl-registry", version = "0.0.0-20250707")
bazel_dep(name = "openssl", version = "3.5.8.bcr.0")
single_version_override(
    module_name = "openssl",
    patch_strip = 1,
    patches = ["//patches:openssl/windows_clang.patch"],
    version = "3.5.8.bcr.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")

# Not a direct dependency: pulled in by ffmpeg/xkbcommon/dbus/... but pinned
# here because < 0.27.0 fails to compile its config checker with libc++ on a
# Windows host (std::ifstream from std::wstring).
bazel_dep(name = "rules_cc_autoconf", version = "0.27.0")

# Not a direct dependency (openssl -> rules_perl), but overridden to add a
# windows/arm64 Perl toolchain (x86_64 Strawberry Perl under Windows-on-Arm
# emulation) so OpenSSL's Perl code generation works when the execution
# platform is windows_arm64. See patches/rules_perl/.
bazel_dep(name = "rules_perl", version = "1.1.2")
single_version_override(
    module_name = "rules_perl",
    patch_strip = 1,
    patches = ["//patches:rules_perl/windows_arm64_emulated_x86_64.patch"],
    version = "1.1.2",
)

bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")

