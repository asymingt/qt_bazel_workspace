# Root workspace name

module(
    name = "qt_workspace",
)

# Hermetic LLVM toolchain

bazel_dep(name = "llvm", version = "0.8.24")
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//patches:llvm/fastbuild_compile_flags.patch",
        "//patches:llvm/header_search_paths.patch",
        "//patches:llvm/msan_libcxx.patch",
        "//patches:llvm/stage0_object_reset.patch",
        "//patches:llvm/llvm21_third_party_zstd.patch",
        "//patches:llvm/asan_runtime.patch",
        "//patches:llvm/sanitizer_runtime_libunwind.patch",
        "//patches:llvm/sanitizer_strip_foreign_source_paths.patch",
        "//patches:llvm/windows_compiler_param_file.patch",
        "//patches:llvm/runtime_library_search_directories_dedup.patch",
    ],
    version = "0.8.24",
)

# Backends built into the from-source `@llvm-project` overlay (used for
# libclang in qttools, or `--@llvm//toolchain:bootstrap_stage=stage1_from_source`).
# The prebuilt cross-compiler always has every backend, so this list does not
# limit which `--platforms` we can compile for; it should mirror the CPUs we
# ship (amd64 + arm64 across Linux/macOS/Windows, see design/PHASE3.md).
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(
    targets = [
        "AArch64",
        "X86",
    ],
)
use_repo(llvm, "llvm-project")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# NOTE: do not add JavaScriptCore or WebKit here. In the SDK archive they are
# symlinks into System/Cryptexes (which is not extracted), i.e. dangling links
# in the sysroot; the darwin sandbox rejects those ("file type ... is not
# supported") whenever macOS is the execution platform. Nothing in the Qt
# modules links them.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(
    names = [
        "AVFAudio",
        "AVFoundation",
        "AVRouting",
        "Accelerate",
        "AppKit",
        "ApplicationServices",
        "AudioToolbox",
        "AudioUnit",
        "CFNetwork",
        "Carbon",
        "CloudKit",
        "Cocoa",
        "ColorSync",
        "CoreAudio",
        "CoreAudioTypes",
        "CoreBluetooth",
        "CoreData",
        "CoreFoundation",
        "CoreGraphics",
        "CoreHaptics",
        "CoreImage",
        "CoreLocation",
        "CoreMIDI",
        "CoreMedia",
        "CoreServices",
        "CoreText",
        "CoreVideo",
        "DiskArbitration",
        "FontServices",
        "ForceFeedback",
        "Foundation",
        "GameController",
        "IOBluetooth",
        "IOKit",
        "IOSurface",
        "ImageIO",
        "Kernel",
        "MediaToolbox",
        "Metal",
        "MetalKit",
        "ModelIO",
        "Network",
        "OSLog",
        "OpenGL",
        "PCSC",
        "PrintCore",
        "QuartzCore",
        "Security",
        "Symbols",
        "SystemConfiguration",
        "UniformTypeIdentifiers",
        "VideoToolbox",
        "_LocationEssentials",
    ],
)

