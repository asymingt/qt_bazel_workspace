# Root workspace name

module(
    name = "qt_workspace",
)

# Hermetic LLVM toolchain

bazel_dep(name = "llvm", version = "0.8.25")
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//patches:llvm/header_search_paths.patch",
        "//patches:llvm/msan_libcxx.patch",
        "//patches:llvm/sanitizer_runtime_libunwind.patch",
        "//patches:llvm/sanitizer_strip_foreign_source_paths.patch",
        "//patches:llvm/windows_compiler_param_file.patch",
        "//patches:llvm/windows_pkg_dir_symlinks.patch",
        "//patches:llvm/runtime_library_search_directories_dedup.patch",
        "//patches:llvm/mingw_def_extra_tokens.patch",
        "//patches:llvm/osx_cryptex_frameworks.patch",
    ],
    version = "0.8.25",
)

# Backends built into the from-source `@llvm-project` overlay (used for
# `--@llvm//toolchain:bootstrap_stage=stage1_from_source`).
# The prebuilt cross-compiler always has every backend, so this list does not
# limit which `--platforms` we can compile for; it should mirror the CPUs we
# ship (amd64 + arm64 across Linux/macOS/Windows, see design/PHASE3.md).
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(
    targets = [
        "AArch64",
        "X86",
    ],
)
use_repo(llvm, "llvm-project")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# WebKit and JavaScriptCore (QtWebView's macOS plugin) are symlinks into
# System/Cryptexes/OS in the macOS 26 SDK; patches/llvm/osx_cryptex_frameworks.patch
# extracts the link targets too, so they resolve (the darwin sandbox rejects
# dangling links whenever macOS is the execution platform).
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(
    names = [
        "AVFAudio",
        "AVFoundation",
        "AVRouting",
        "Accelerate",
        "AppKit",
        "ApplicationServices",
        "AudioToolbox",
        "AudioUnit",
        "CFNetwork",
        "Carbon",
        "CloudKit",
        "Cocoa",
        "ColorSync",
        "CoreAudio",
        "CoreAudioTypes",
        "CoreBluetooth",
        "CoreData",
        "CoreFoundation",
        "CoreGraphics",
        "CoreHaptics",
        "CoreImage",
        "CoreLocation",
        "CoreMIDI",
        "CoreMedia",
        "CoreServices",
        "CoreText",
        "CoreVideo",
        "DiskArbitration",
        "FontServices",
        "ForceFeedback",
        "Foundation",
        "GameController",
        "IOBluetooth",
        "IOKit",
        "IOSurface",
        "JavaScriptCore",
        "ImageIO",
        "Kernel",
        "MediaToolbox",
        "Metal",
        "MetalKit",
        "ModelIO",
        "Network",
        "OSLog",
        "OpenGL",
        "PCSC",
        "PrintCore",
        "QuartzCore",
        "Security",
        "Symbols",
        "SystemConfiguration",
        "UniformTypeIdentifiers",
        "VideoToolbox",
        "WebKit",
        "_LocationEssentials",
    ],
)

# QtPrintSupport on macOS (qcocoaprintdevice.mm) uses the CUPS PPD API and
# links -lcups; libcups.tbd is not in the default minimal sysroot.
osx.libraries(names = ["libcups"])

# BCR modules

bazel_dep(name = "assimp", version = "6.0.5")
bazel_dep(name = "egl-registry", version = "0.0.0-20250527")
bazel_dep(name = "eigen", version = "5.0.1.bcr.1")
bazel_dep(name = "ffmpeg", version = "7.1.1.bcr.beta.13")
single_version_override(
    module_name = "ffmpeg",
    patch_strip = 1,
    patches = ["//patches:ffmpeg/sysctl.patch"],
    version = "7.1.1.bcr.beta.13",
)

bazel_dep(name = "opengl-registry", version = "0.0.0-20250707")
bazel_dep(name = "openssl", version = "3.5.8.bcr.0")
single_version_override(
    module_name = "openssl",
    patch_strip = 1,
    patches = [
        "//patches:openssl/perlasm_gnu_section_syntax.patch",
        "//patches:openssl/windows_clang.patch",
    ],
    version = "3.5.8.bcr.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")

# Not a direct dependency: pulled in by ffmpeg/xkbcommon/dbus/... but pinned
# here because < 0.27.0 fails to compile its config checker with libc++ on a
# Windows host (std::ifstream from std::wstring).
bazel_dep(name = "rules_cc_autoconf", version = "0.27.0")

# Not a direct dependency (wayland -> libexpat), but pinned here because
# < 2.8.3 has no Windows branch in its config header. wayland-scanner (and so
# libexpat) is built for the execution platform, which is Windows when
# cross-compiling a Linux target from a Windows host.
bazel_dep(name = "libexpat", version = "2.8.3")

bazel_dep(name = "freetype", version = "2.14.1.bcr.1")

bazel_dep(name = "libjpeg_turbo", version = "3.1.3.bcr.4")

# Its Windows x86_64 copts are MSVC-only (/Ox, -wd4996), which breaks MinGW
# (x86_64-w64-windows-gnu) targets. The patch selects them by compiler instead
# of by OS. Intended for upstreaming to the BCR module.
single_version_override(
    module_name = "libjpeg_turbo",
    patch_strip = 1,
    patches = ["//patches:libjpeg_turbo/mingw_copts.patch"],
    version = "3.1.3.bcr.4",
)
bazel_dep(name = "libpng", version = "1.6.58.bcr.1")

bazel_dep(name = "libx11", version = "1.8.12.bcr.5")

bazel_dep(name = "zlib", version = "1.3.2.bcr.2")

# Not a direct dependency (openssl -> rules_perl), but overridden to add a
# windows/arm64 Perl toolchain (x86_64 Strawberry Perl under Windows-on-Arm
# emulation) so OpenSSL's Perl code generation works when the execution
# platform is windows_arm64. See patches/rules_perl/.
bazel_dep(name = "rules_perl", version = "1.1.2")
single_version_override(
    module_name = "rules_perl",
    patch_strip = 1,
    patches = ["//patches:rules_perl/windows_arm64_emulated_x86_64.patch"],
    version = "1.1.2",
)

bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "vulkan_headers", version = "1.4.349")
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")

