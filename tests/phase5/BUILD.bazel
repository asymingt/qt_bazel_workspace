load("@qt//:qt.bzl", "qt_cc_test")
load("@rules_cc//cc:defs.bzl", "cc_library")

# Phase 5 (design/PHASE5.md): qtmqtt, qtcoap and qtopcua.

# M5.1: QtMqtt client against an in-process MQTT 3.1.1 broker.
qt_cc_test(
    name = "mqtt_test",
    srcs = ["mqtt_test.cc"],
    moc_srcs = ["mqtt_test.cc"],
    deps = [
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtbase//:test",
        "@qtmqtt//:mqtt",
    ],
)

# M5.2: QtCoap client against an in-process CoAP (UDP) server.
qt_cc_test(
    name = "coap_test",
    srcs = ["coap_test.cc"],
    moc_srcs = ["coap_test.cc"],
    deps = [
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtbase//:test",
        "@qtcoap//:coap",
    ],
)

# M5.3: QtOpcUa + open62541 backend against an in-process open62541 server.
qt_cc_test(
    name = "opcua_test",
    srcs = ["opcua_test.cc"],
    moc_srcs = ["opcua_test.cc"],
    deps = [
        "@qtbase//:core",
        "@qtbase//:network",
        "@qtbase//:test",
        "@qtopcua//:open62541",
        "@qtopcua//:opcua",
        "@qtopcua//:opcua_plugins",
        ":opcua_x509_if_supported",
    ],
)

# QT_FEATURE_gds (QOpcUaKeyPair, ...) is not built on macOS, as upstream.
cc_library(
    name = "opcua_x509_if_supported",
    testonly = True,
    deps = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@qtopcua//:opcua_x509"],
    }),
)

# M5.4: `import QtOpcUa` QML module.
qt_cc_test(
    name = "opcua_qml_test",
    srcs = ["opcua_qml_test.cc"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    moc_srcs = ["opcua_qml_test.cc"],
    deps = [
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtbase//:test",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:qmlplugin",
        "@qtopcua//:declarative_opcua",
        "@qtopcua//:declarative_opcuaplugin",
        "@qtopcua//:opcua_plugins",
    ],
)
