load(
    "@qt//:qt.bzl",
    "QT_SHARED_PLATFORM_LINKOPTS",
    "qt_export_header",
    "qt_module_headers",
    "qt_qml_module",
)
load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:GPL-3.0-only"],
    license_text = "LICENSES/GPL-3.0-only.txt",
)

# ============================================================================
# Qt6Lottie + lottieqtplugin
# ============================================================================

qt_export_header(
    name = "lottie_export",
    module_Header = "Lottie",
    module_name = "lottie",
)

LOTTIE_HEADERS = [
    "src/lottie/qbeziereasing_p.h",
    "src/lottie/qlottiebase_p.h",
    "src/lottie/qlottiebasictransform_p.h",
    "src/lottie/qlottieconstants_p.h",
    "src/lottie/qlottieellipse_p.h",
    "src/lottie/qlottiefill_p.h",
    "src/lottie/qlottiefilleffect_p.h",
    "src/lottie/qlottieflatlayers_p.h",
    "src/lottie/qlottiefreeformshape_p.h",
    "src/lottie/qlottiegfill_p.h",
    "src/lottie/qlottiegroup_p.h",
    "src/lottie/qlottieimage_p.h",
    "src/lottie/qlottielayer_p.h",
    "src/lottie/qlottiepolystar_p.h",
    "src/lottie/qlottieprecomplayer_p.h",
    "src/lottie/qlottieproperty_p.h",
    "src/lottie/qlottierect_p.h",
    "src/lottie/qlottierepeater_p.h",
    "src/lottie/qlottierepeatertransform_p.h",
    "src/lottie/qlottieroot_p.h",
    "src/lottie/qlottieround_p.h",
    "src/lottie/qlottieshape_p.h",
    "src/lottie/qlottieshapelayer_p.h",
    "src/lottie/qlottieshapetransform_p.h",
    "src/lottie/qlottiespatialproperty_p.h",
    "src/lottie/qlottiestroke_p.h",
    "src/lottie/qlottietrimpath_p.h",
    "src/lottie/renderer/qbatchrenderer_p.h",
    "src/lottie/renderer/qlottierasterrenderer_p.h",
    "src/lottie/renderer/qlottierenderer_p.h",
    "src/qml/qlottieanimation_p.h",
]

qt_module_headers(
    name = "lottie_headers",
    hdrs = LOTTIE_HEADERS,
    extra_deps = [":lottie_export"],
    module_name = "Lottie",
)

qt_qml_module(
    name = "lottie",
    srcs = [
        "src/lottie/qbeziereasing.cpp",
        "src/lottie/qlottiebase.cpp",
        "src/lottie/qlottiebasictransform.cpp",
        "src/lottie/qlottieellipse.cpp",
        "src/lottie/qlottiefill.cpp",
        "src/lottie/qlottiefilleffect.cpp",
        "src/lottie/qlottieflatlayers.cpp",
        "src/lottie/qlottiefreeformshape.cpp",
        "src/lottie/qlottiegfill.cpp",
        "src/lottie/qlottiegroup.cpp",
        "src/lottie/qlottieimage.cpp",
        "src/lottie/qlottielayer.cpp",
        "src/lottie/qlottiepolystar.cpp",
        "src/lottie/qlottieprecomplayer.cpp",
        "src/lottie/qlottierect.cpp",
        "src/lottie/qlottierepeater.cpp",
        "src/lottie/qlottierepeatertransform.cpp",
        "src/lottie/qlottieroot.cpp",
        "src/lottie/qlottieround.cpp",
        "src/lottie/qlottieshape.cpp",
        "src/lottie/qlottieshapelayer.cpp",
        "src/lottie/qlottieshapetransform.cpp",
        "src/lottie/qlottiestroke.cpp",
        "src/lottie/qlottietrimpath.cpp",
        "src/lottie/renderer/qbatchrenderer.cpp",
        "src/lottie/renderer/qlottierasterrenderer.cpp",
        "src/lottie/renderer/qlottierenderer.cpp",
        "src/qml/qlottieanimation.cpp",
    ],
    hdrs = LOTTIE_HEADERS,
    import_name = "Qt.labs.lottieqt",
    import_version = "6.10",
    includes = [
        "src/lottie",
        "src/lottie/renderer",
        "src/qml",
    ],
    local_defines = [
        "QT_BUILD_LOTTIE_LIB",
    ],
    plugin_class_name = "Qt_labs_lottieqtPlugin",
    plugin_target = "lottieqtplugin",
    deps = [
        ":lottie_export",
        ":lottie_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)

cc_shared_library(
    name = "lottie_shared",
    dynamic_deps = [
        "@qtdeclarative//:quick_shared",
        "@qtdeclarative//:qmlmeta_shared",
        "@qtdeclarative//:qmlmodels_shared",
        "@qtdeclarative//:qmlworkerscript_shared",
        "@qtdeclarative//:qml_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:dbus_shared",
        "@qtbase//:network_shared",
        "@qtbase//:core_shared",
    ],
    shared_lib_name = select({
        "@platforms//os:windows": "liblottie_shared.dll",
        "//conditions:default": "",
    }),
    user_link_flags = QT_SHARED_PLATFORM_LINKOPTS,
    deps = [":lottie"],
)

# ============================================================================
# Qt6LottieVectorImageHelpers
# ============================================================================

qt_export_header(
    name = "lottievectorimagehelpers_export",
    module_Header = "LottieVectorImageHelpers",
    module_name = "lottievectorimagehelpers",
)

LOTTIEVECTORIMAGEHELPERS_HEADERS = [
    "src/vectorimagehelpers/qquicklayeritem_p.h",
]

qt_module_headers(
    name = "lottievectorimagehelpers_headers",
    hdrs = LOTTIEVECTORIMAGEHELPERS_HEADERS,
    extra_deps = [":lottievectorimagehelpers_export"],
    module_name = "LottieVectorImageHelpers",
)

qt_qml_module(
    name = "lottievectorimagehelpers",
    srcs = ["src/vectorimagehelpers/qquicklayeritem.cpp"],
    hdrs = LOTTIEVECTORIMAGEHELPERS_HEADERS,
    import_name = "Qt.labs.lottieqt.VectorImageHelpers",
    import_version = "6.10",
    included_moc_hdrs = ["src/vectorimagehelpers/qquicklayeritem_p.h"],
    includes = ["src/vectorimagehelpers"],
    local_defines = [
        "QT_BUILD_LOTTIEVECTORIMAGEHELPERS_LIB",
    ],
    plugin_class_name = "QLottieVectorImageHelpersPlugin",
    plugin_target = "lottievectorimagehelpersplugin",
    deps = [
        ":lottievectorimagehelpers_export",
        ":lottievectorimagehelpers_headers",
        "@qtbase//:core",
        "@qtbase//:gui",
        "@qtdeclarative//:qml",
        "@qtdeclarative//:quick",
    ],
)

cc_shared_library(
    name = "lottievectorimagehelpers_shared",
    dynamic_deps = [
        "@qtdeclarative//:quick_shared",
        "@qtdeclarative//:qmlmeta_shared",
        "@qtdeclarative//:qmlmodels_shared",
        "@qtdeclarative//:qmlworkerscript_shared",
        "@qtdeclarative//:qml_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:dbus_shared",
        "@qtbase//:network_shared",
        "@qtbase//:core_shared",
    ],
    shared_lib_name = select({
        "@platforms//os:windows": "liblottievectorimagehelpers_shared.dll",
        "//conditions:default": "",
    }),
    user_link_flags = QT_SHARED_PLATFORM_LINKOPTS,
    deps = [":lottievectorimagehelpers"],
)
