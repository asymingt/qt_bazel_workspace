load("@qt//:qt.bzl", "QT_VERSION", "common_defines", "qt_internal_library", "qt_qml_plugin_cpp", "qt_static_plugin", "qt_sync_headers")
load("@rules_license//rules:license.bzl", "license")
load(":qtspeech_config.bzl", "declare_qtspeech_config_targets")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-only",
        "@rules_license//licenses/spdx:GPL-2.0-only",
        "@rules_license//licenses/spdx:GPL-3.0-only",
    ],
    license_text = "LICENSES/LGPL-3.0-only.txt",
)

_COMMON_DEFINES = common_defines + [
    "QT_NO_AS_CONST=1",
    "QT_NO_CONTEXTLESS_CONNECT=1",
    "QT_NO_FOREACH=1",
]

declare_qtspeech_config_targets()

qt_sync_headers(
    name = "tts_sync_headers",
    srcs = glob([
        "src/tts/*.h",
    ]),
    generated_private_hdrs = [
        ":gen_qttexttospeech_config_p_h",
    ],
    generated_public_hdrs = [
        ":gen_qttexttospeech_config_h",
    ],
    module_name = "QtTextToSpeech",
    version = QT_VERSION,
)

qt_internal_library(
    name = "tts",
    srcs = [
        "src/tts/qtexttospeech.cpp",
        "src/tts/qtexttospeechengine.cpp",
        "src/tts/qtexttospeechplugin.cpp",
        "src/tts/qvoice.cpp",
    ],
    hdrs = glob([
        "src/tts/*.h",
    ]) + [":tts_sync_headers"],
    defines = ["QT_TEXTTOSPEECH_LIB"],
    dynamic_deps = [
        "@qtbase//:concurrent_shared",
        "@qtbase//:core_shared",
        "@qtbase//:dbus_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtmultimedia//:multimedia_shared",
    ],
    includes = ["src/tts"],
    local_defines = _COMMON_DEFINES + ["QTEXTTOSPEECH_LIBRARY"],
    moc_hdrs = [
        "src/tts/qtexttospeech.h",
        "src/tts/qtexttospeechengine.h",
        "src/tts/qvoice.h",
    ],
    moc_unity = True,
    deps = [
        "@qtbase//:core",
        "@qtmultimedia//:multimedia",
    ],
)

qt_sync_headers(
    name = "ttsqml_sync_headers",
    srcs = glob([
        "src/tts/qml/*.h",
    ]),
    module_name = "QtTextToSpeechQml",
    version = QT_VERSION,
)

qt_internal_library(
    name = "ttsqml",
    srcs = [
        "src/tts/qml/qdeclarativetexttospeech.cpp",
        "src/tts/qml/qvoiceselectorattached.cpp",
    ],
    hdrs = glob([
        "src/tts/qml/*.h",
    ]) + [":ttsqml_sync_headers"],
    defines = ["QT_TEXTTOSPEECHQML_LIB"],
    dynamic_deps = [
        ":tts_shared",
        "@qtbase//:concurrent_shared",
        "@qtbase//:core_shared",
        "@qtbase//:dbus_shared",
        "@qtbase//:gui_shared",
        "@qtbase//:network_shared",
        "@qtdeclarative//:qml_shared",
        "@qtmultimedia//:multimedia_shared",
    ],
    includes = ["src/tts/qml"],
    local_defines = _COMMON_DEFINES + ["QT_BUILD_TEXTTOSPEECHQML_LIB"],
    moc_hdrs = [
        "src/tts/qml/qdeclarativetexttospeech_p.h",
        "src/tts/qml/qtexttospeech_qmltypes_p.h",
        "src/tts/qml/qvoiceselectorattached_p.h",
    ],
    moc_unity = True,
    qml_args = {
        "uri": "QtTextToSpeech",
        "version": "6.10",
        "foreign_types": [
            ":tts_moc_hdrs",
            "@qtbase//:core_moc_hdrs",
            "@qtdeclarative//:qml_moc_hdrs",
        ],
        "qmldir_content": """module QtTextToSpeech
linktarget ttsqmlplugin
plugin ttsqmlplugin
classname QtTextToSpeechPlugin
typeinfo plugins.qmltypes
prefer :/qt-project.org/imports/QtTextToSpeech/
""",
    },
    deps = [
        ":tts",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_qml_plugin_cpp(
    name = "ttsqmlplugin_gen",
    out = "ttsqmlplugin_QtTextToSpeechPlugin.cpp",
    plugin_class_name = "QtTextToSpeechPlugin",
    uri = "QtTextToSpeech",
)

qt_static_plugin(
    name = "ttsqmlplugin",
    srcs = [":ttsqmlplugin_gen"],
    local_defines = _COMMON_DEFINES,
    moc_srcs = [":ttsqmlplugin_gen"],
    plugin_class_name = "QtTextToSpeechPlugin",
    deps = [
        ":tts",
        ":ttsqml",
        "@qtbase//:core",
        "@qtdeclarative//:qml",
    ],
)

qt_static_plugin(
    name = "qtexttospeech_mock",
    srcs = [
        "src/plugins/tts/mock/qtexttospeech_mock.cpp",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.cpp",
    ],
    hdrs = [
        "src/plugins/tts/mock/qtexttospeech_mock.h",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.h",
    ],
    includes = ["src/plugins/tts/mock"],
    local_defines = _COMMON_DEFINES,
    moc_hdrs = [
        "src/plugins/tts/mock/qtexttospeech_mock.h",
        "src/plugins/tts/mock/qtexttospeech_mock_plugin.h",
    ],
    plugin_class_name = "QTextToSpeechMockPlugin",
    deps = [
        ":tts",
        "@qtbase//:core",
    ],
)
