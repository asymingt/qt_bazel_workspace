load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "COPYING",
)

exports_files(["COPYING"])

HDRS = [
    "image/xcb_bitops.h",
    "image/xcb_image.h",
    "image/xcb_pixel.h",
]

cc_library(
    name = "image_prefixed_hdrs",
    hdrs = HDRS,
    include_prefix = "xcb",
    strip_include_prefix = "image",
)

cc_library(
    name = "xcb-image",
    srcs = ["image/xcb_image.c"],
    hdrs = HDRS,
    includes = ["image"],
    visibility = ["//visibility:public"],
    deps = [
        ":image_prefixed_hdrs",
        "@libxcb",
        "@libxcb-util",
        "@xorgproto",
    ],
)

alias(
    name = "libxcb-image",
    actual = ":xcb-image",
    visibility = ["//visibility:public"],
)

alias(
    name = "image",
    actual = ":xcb-image",
    visibility = ["//visibility:public"],
)
