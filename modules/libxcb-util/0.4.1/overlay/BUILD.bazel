load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "COPYING",
)

exports_files(["COPYING"])

HDRS = [
    "src/xcb_atom.h",
    "src/xcb_aux.h",
    "src/xcb_event.h",
    "src/xcb_util.h",
]

cc_library(
    name = "xcb-util_prefixed_hdrs",
    hdrs = HDRS,
    include_prefix = "xcb",
    strip_include_prefix = "src",
)

cc_library(
    name = "xcb-util",
    srcs = [
        "src/atoms.c",
        "src/event.c",
        "src/xcb_aux.c",
    ],
    hdrs = HDRS,
    includes = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        ":xcb-util_prefixed_hdrs",
        "@libxcb",
        "@xorgproto",
    ],
)

alias(
    name = "libxcb-util",
    actual = ":xcb-util",
    visibility = ["//visibility:public"],
)
