load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "COPYING",
)

exports_files(["COPYING"])

cc_library(
    name = "icccm_prefixed_hdrs",
    hdrs = ["icccm/xcb_icccm.h"],
    include_prefix = "xcb",
    strip_include_prefix = "icccm",
)

cc_library(
    name = "xcb-icccm",
    srcs = ["icccm/icccm.c"],
    hdrs = ["icccm/xcb_icccm.h"],
    includes = ["icccm"],
    visibility = ["//visibility:public"],
    deps = [
        ":icccm_prefixed_hdrs",
        "@libxcb",
        "@xorgproto",
    ],
)

alias(
    name = "libxcb-wm",
    actual = ":xcb-icccm",
    visibility = ["//visibility:public"],
)

alias(
    name = "icccm",
    actual = ":xcb-icccm",
    visibility = ["//visibility:public"],
)
