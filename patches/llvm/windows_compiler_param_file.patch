diff --git a/toolchain/features/BUILD.bazel b/toolchain/features/BUILD.bazel
index 6f8c0ca..1952d7a 100644
--- a/toolchain/features/BUILD.bazel
+++ b/toolchain/features/BUILD.bazel
@@ -13,6 +13,31 @@ cc_feature(
     feature_name = "gcc_quoting_for_param_files",
 )
 
+# CreateProcessW limits a command line to 32,767 characters. That limit belongs
+# to the execution platform, not the target: compiling for Linux or macOS on a
+# Windows host is subject to it too. Toolchains that execute on Windows enable
+# both features below regardless of target, and clang-cl enables them for every
+# execution platform.
+cc_feature(
+    name = "compiler_param_file",
+    feature_name = "compiler_param_file",
+)
+
+# Takes precedence over compiler_param_file in Bazel versions that support it,
+# so that param files are only used for long command lines.
+cc_feature(
+    name = "compiler_param_file_on_demand",
+    feature_name = "compiler_param_file_on_demand",
+)
+
+cc_feature_set(
+    name = "compiler_param_file_features",
+    all_of = [
+        ":compiler_param_file",
+        ":compiler_param_file_on_demand",
+    ],
+)
+
 _DEBUG_INFO_COMPILE_ACTIONS = [
     "@rules_cc//cc/toolchains/actions:c_compile",
     "@rules_cc//cc/toolchains/actions:cpp_compile",
