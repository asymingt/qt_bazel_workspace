+    { (yyval.file_type) = FILE_TYPE_KEYMAP; }
+    break;
+
+  case 7:
+    { (yyval.file_type) = FILE_TYPE_KEYMAP; }
+    break;
+
+  case 8:
+    { (yyval.file_type) = FILE_TYPE_KEYMAP; }
+    break;
+
